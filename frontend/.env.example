# ============================================================================
# RetinaOps frontend configuration — copy to .env and adjust.
# ============================================================================
#
# ── Option A (DEV, recommended): Vite proxy — avoids CORS, no backend change ─
#   The browser calls the Vite dev server same-origin; Vite forwards to the API.
#   VITE_API_URL must be a RELATIVE path (e.g. /api) and the proxy needs a target.
VITE_API_URL=/api
VITE_DEV_PROXY_TARGET=http://localhost:30080/
#
# ── Option B (PROD, or backend already sends CORS headers): direct ───────────
#   Absolute backend URL; leave the proxy target empty. Backend must allow CORS.
# VITE_API_URL=http://<NODE-IP>:30080
# VITE_DEV_PROXY_TARGET=
